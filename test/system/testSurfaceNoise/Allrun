#!/bin/sh
cd ${0%/*} || exit 1    # Run from this directory

# Compares surfaceNoise spectra with an independent numpy implementation,
# checks tone amplitudes, aliasing and error handling (needs python3, numpy)

printf '===== Running AllRun =====\n\n' > total.log

python3 testSurfaceNoise.py cases >> total.log 2>&1
errors=$?

if [ "$errors" = "0" ]; then
    printf '\n===== testSurfaceNoise\t\tOK =====\n' >> total.log
    echo $errors > successful.txt
else
    printf '\n===== testSurfaceNoise\t\tFAILED =====\n' >> total.log
    echo $errors > failed.txt
fi

